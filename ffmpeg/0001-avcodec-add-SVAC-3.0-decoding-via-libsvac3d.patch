+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * SVAC 3.0 decoding through libsvac3d
+ */
+
+#include <svac3d.h>
+
+#include "libavutil/fifo.h"
+#include "libavutil/imgutils.h"
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "decode.h"
+
+typedef struct LibSVAC3DContext {
+    svac3d_t *dec;
+    AVCodecContext *avctx;
+    AVPacket *pkt;
+    AVFifo *frames;          ///< decoded pictures not yet returned, AVFrame *
+    int err;                 ///< error raised inside the output callback
+    int pending_err;         ///< error to return once the queued pictures are out
+} LibSVAC3DContext;
+
+static int svac3d_error(int err)
+{
+    switch (err) {
+    case SVAC3D_ERR_UNSUPPORTED: return AVERROR_PATCHWELCOME;
+    case SVAC3D_ERR_NOMEM:       return AVERROR(ENOMEM);
+    case SVAC3D_ERR_ARG:         return AVERROR(EINVAL);
+    default:                     return AVERROR_INVALIDDATA;
+    }
+}
+
+/* Called by svac3d_decode() for each picture: copy it into a frame of our
+ * own and queue it, since one packet may complete several pictures. */
+static void svac3d_output(void *opaque, const svac3d_picture_t *pic)
+{
+    LibSVAC3DContext *s = opaque;
+    AVCodecContext *avctx = s->avctx;
+    svac3d_info_t info;
+    AVFrame *frame;
+    int ret;
+
+    if (s->err)
+        return;
+    if (pic->width != avctx->width || pic->height != avctx->height) {
+        ret = ff_set_dimensions(avctx, pic->width, pic->height);
+        if (ret < 0) {
+            s->err = ret;
+            return;
+        }
+    }
+    if (!svac3d_get_info(s->dec, &info) && info.frame_rate_num)
+        avctx->framerate = (AVRational){ info.frame_rate_num, info.frame_rate_den };
+
+    frame = av_frame_alloc();
+    if (!frame) {
+        s->err = AVERROR(ENOMEM);
+        return;
+    }
+    ret = ff_get_buffer(avctx, frame, 0);
+    if (ret < 0) {
+        av_frame_free(&frame);
+        s->err = ret;
+        return;
+    }
+    for (int i = 0; i < 3; i++) {
+        const int w = i ? AV_CEIL_RSHIFT(pic->width, 1) : pic->width;
+        const int h = i ? AV_CEIL_RSHIFT(pic->height, 1) : pic->height;
+        av_image_copy_plane(frame->data[i], frame->linesize[i],
+                            pic->data[i], pic->linesize[i], w, h);
+    }
+    frame->pict_type = pic->pict_type == 1 ? AV_PICTURE_TYPE_I : AV_PICTURE_TYPE_P;
+    if (pic->pict_type == 1)
+        frame->flags |= AV_FRAME_FLAG_KEY;
+    else
+        frame->flags &= ~AV_FRAME_FLAG_KEY;
+    ret = av_fifo_write(s->frames, &frame, 1);
+    if (ret < 0) {
+        av_frame_free(&frame);
+        s->err = ret;
+    }
+}
+
+static void drop_frames(LibSVAC3DContext *s)
+{
+    AVFrame *frame;
+
+    while (s->frames && av_fifo_read(s->frames, &frame, 1) >= 0)
+        av_frame_free(&frame);
+}
+
+static av_cold int libsvac3d_init(AVCodecContext *avctx)
+{
+    LibSVAC3DContext *s = avctx->priv_data;
+
+    s->avctx  = avctx;
+    s->pkt    = av_packet_alloc();
+    s->frames = av_fifo_alloc2(2, sizeof(AVFrame *), AV_FIFO_FLAG_AUTO_GROW);
+    s->dec    = svac3d_open();
+    if (!s->pkt || !s->frames || !s->dec)
+        return AVERROR(ENOMEM);
+    avctx->pix_fmt = AV_PIX_FMT_YUV420P;
+
+    /* parameter sets carried out of band */
+    if (avctx->extradata_size > 0) {
+        int ret = svac3d_decode(s->dec, avctx->extradata, avctx->extradata_size, NULL, NULL);
+        if (ret < 0) {
+            av_log(avctx, AV_LOG_WARNING, "Could not decode extradata (%d)\n", ret);
+            if (avctx->err_recognition & AV_EF_EXPLODE)
+                return svac3d_error(ret);
+        }
+    }
+    return 0;
+}
+
+static av_cold int libsvac3d_close(AVCodecContext *avctx)
+{
+    LibSVAC3DContext *s = avctx->priv_data;
+
+    drop_frames(s);
+    av_fifo_freep2(&s->frames);
+    av_packet_free(&s->pkt);
+    svac3d_close(s->dec);
+    s->dec = NULL;
+    return 0;
+}
+
+static void libsvac3d_flush(AVCodecContext *avctx)
+{
+    LibSVAC3DContext *s = avctx->priv_data;
+
+    drop_frames(s);
+    s->pending_err = 0;
+    svac3d_reset(s->dec);
+}
+
+static int libsvac3d_receive_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    LibSVAC3DContext *s = avctx->priv_data;
+    AVFrame *out;
+    int ret;
+
+    for (;;) {
+        if (av_fifo_read(s->frames, &out, 1) >= 0) {
+            av_frame_move_ref(frame, out);
+            av_frame_free(&out);
+            return 0;
+        }
+        if (s->pending_err) {
+            /* reported after the pictures the same packet did produce */
+            ret = s->pending_err;
+            s->pending_err = 0;
+            return ret;
+        }
+
+        ret = ff_decode_get_packet(avctx, s->pkt);
+        if (ret < 0)
+            return ret;                     /* EAGAIN, or EOF: no pictures are held back */
+        s->err = 0;
+        ret = svac3d_decode(s->dec, s->pkt->data, s->pkt->size, svac3d_output, s);
+        av_packet_unref(s->pkt);
+        if (s->err < 0) {
+            s->pending_err = s->err;
+        } else if (ret < 0) {
+            av_log(avctx, AV_LOG_ERROR, "Decoding failed (%d)%s\n", ret,
+                   ret == SVAC3D_ERR_CORRUPT ? ": corrupt patch, or its reference is missing" : "");
+            s->pending_err = svac3d_error(ret);
+        }
+    }
+}
+
+const FFCodec ff_libsvac3d_decoder = {
+    .p.name         = "libsvac3d",
+    CODEC_LONG_NAME("libsvac3d SVAC 3.0"),
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_SVAC3,
+    .priv_data_size = sizeof(LibSVAC3DContext),
+    .init           = libsvac3d_init,
+    .close          = libsvac3d_close,
+    .flush          = libsvac3d_flush,
+    FF_CODEC_RECEIVE_FRAME_CB(libsvac3d_receive_frame),
+    .p.capabilities = AV_CODEC_CAP_DR1,
+    .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP,
+    .p.wrapper_name = "libsvac3d",
+};
