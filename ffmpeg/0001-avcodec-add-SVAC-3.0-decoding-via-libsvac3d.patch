+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_SVAC3_H
+#define AVCODEC_SVAC3_H
+
+/* NAL unit types of SVAC 3.0 (draft GB/T, plan 20243294-T-312), 2-byte header */
+enum {
+    SVAC3_NAL_NRAP_PATCH = 1,
+    SVAC3_NAL_RAPI_PATCH = 2,
+    SVAC3_NAL_PIC_HEADER = 3,
+    SVAC3_NAL_IDR_PATCH  = 4,
+    SVAC3_NAL_EXTENSION  = 5,
+    SVAC3_NAL_SEI        = 6,
+    SVAC3_NAL_SPS        = 7,
+    SVAC3_NAL_PPS        = 8,
+    SVAC3_NAL_SEC_PS     = 9,
+    SVAC3_NAL_AUTH_DATA  = 10,
+    SVAC3_NAL_EOS        = 11,
+};
+
+#define SVAC3_NAL_TYPE(h1) ((h1) & 0x1f)
+
+/* Types that carry patch data: display, library, crossed and privacy patches */
+static inline int ff_svac3_nal_is_patch(int type)
+{
+    return type == 1 || type == 2 || type == 4 || type == 12 || type == 14 ||
+           (type >= 17 && type <= 19);
+}
+
+/* Types that open an access unit when they follow its patches */
+static inline int ff_svac3_nal_starts_au(int type)
+{
+    return type == SVAC3_NAL_PIC_HEADER || type == SVAC3_NAL_EXTENSION ||
+           type == SVAC3_NAL_SEI || type == SVAC3_NAL_SPS || type == SVAC3_NAL_PPS ||
+           type == SVAC3_NAL_SEC_PS;
+}
+
+#endif /* AVCODEC_SVAC3_H */
diff --git a/libavcodec/svac3_parser.c b/libavcodec/svac3_parser.c
new file mode 100644
index 0000000..73bbf5e
--- /dev/null
+++ b/libavcodec/svac3_parser.c
@@ -0,0 +1,118 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * SVAC 3.0 parser: splits an Annex-B stream into access units, each the
+ * parameter sets, picture header and patches of one picture.
+ */
+
+#include "parser.h"
+#include "parser_internal.h"
+#include "svac3.h"
+
+typedef struct SVAC3ParseContext {
+    ParseContext pc;
+    int patch_seen;          ///< the access unit being collected has a patch
+} SVAC3ParseContext;
+
+static int svac3_find_frame_end(SVAC3ParseContext *p, const uint8_t *buf, int buf_size)
+{
+    ParseContext *pc = &p->pc;
+    uint64_t state = pc->state64;
+
+    for (int i = 0; i < buf_size; i++) {
+        int type;
+
+        state = (state << 8) | buf[i];
+        /* 00 00 01 and the two header bytes */
+        if ((state & 0xFFFFFF0000ULL) != 0x10000ULL)
+            continue;
+        type = SVAC3_NAL_TYPE(state);
+        if (ff_svac3_nal_is_patch(type)) {
+            p->patch_seen = 1;
+        } else if (p->patch_seen && ff_svac3_nal_starts_au(type)) {
+            p->patch_seen = 0;
+            pc->state64   = -1;
+            return i - 4;
+        }
+    }
+    pc->state64 = state;
+    return END_NOT_FOUND;
+}
+
+static void svac3_parse_units(AVCodecParserContext *s, const uint8_t *buf, int buf_size)
+{
+    const uint8_t *end = buf + buf_size;
+
+    s->key_frame = 0;
+    s->pict_type = AV_PICTURE_TYPE_NONE;
+    for (const uint8_t *p = buf; p + 4 < end; p++) {
+        int type;
+
+        if (p[0] || p[1] || p[2] != 1)
+            continue;
+        type = SVAC3_NAL_TYPE(p[4]);
+        if (type == SVAC3_NAL_IDR_PATCH || type == SVAC3_NAL_RAPI_PATCH) {
+            s->key_frame = 1;
+            s->pict_type = AV_PICTURE_TYPE_I;
+        }
+        p += 2;
+    }
+}
+
+static int svac3_parse(AVCodecParserContext *s, AVCodecContext *avctx,
+                       const uint8_t **poutbuf, int *poutbuf_size,
+                       const uint8_t *buf, int buf_size)
+{
+    SVAC3ParseContext *p = s->priv_data;
+    int next;
+
+    if (s->flags & PARSER_FLAG_COMPLETE_FRAMES) {
+        next = buf_size;
+    } else {
+        next = svac3_find_frame_end(p, buf, buf_size);
+        if (ff_combine_frame(&p->pc, next, &buf, &buf_size) < 0) {
+            *poutbuf      = NULL;
+            *poutbuf_size = 0;
+            return buf_size;
+        }
+    }
+
+    svac3_parse_units(s, buf, buf_size);
+
+    *poutbuf      = buf;
+    *poutbuf_size = buf_size;
+    return next;
+}
+
+static av_cold int svac3_parser_init(AVCodecParserContext *s)
+{
+    SVAC3ParseContext *p = s->priv_data;
+
+    p->pc.state64 = -1;
+    return 0;
+}
+
+const FFCodecParser ff_svac3_parser = {
+    PARSER_CODEC_LIST(AV_CODEC_ID_SVAC3),
+    .priv_data_size = sizeof(SVAC3ParseContext),
+    .init           = svac3_parser_init,
+    .parse          = svac3_parse,
+    .close          = ff_parse_close,
+};
