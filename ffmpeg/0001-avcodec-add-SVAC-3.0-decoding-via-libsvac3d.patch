+/**
+ * @file
+ * Raw SVAC 3.0 video demuxer
+ */
+
+#include "libavcodec/svac3.h"
+#include "avformat.h"
+#include "rawdec.h"
+
+static int svac3_probe(const AVProbeData *p)
+{
+    const uint8_t *buf = p->buf, *end = p->buf + p->buf_size;
+    int sps = 0, ph = 0, patch = 0;
+
+    for (; buf + 5 < end; buf++) {
+        int type;
+
+        if (buf[0] || buf[1] || buf[2] != 1)
+            continue;
+        if (buf[3] & 0x80)
+            return 0;                       /* forbidden_zero_bit */
+        type = SVAC3_NAL_TYPE(buf[4]);
+        if (type == SVAC3_NAL_SPS) {
+            /* profile_id: Main 0x30, High 0x40, the 0x42 variant */
+            if (buf[5] != 0x30 && buf[5] != 0x40 && buf[5] != 0x42)
+                return 0;
+            sps++;
+        } else if (type == SVAC3_NAL_PIC_HEADER) {
+            ph++;
+        } else if (ff_svac3_nal_is_patch(type)) {
+            if (!sps || !ph)
+                return 0;                   /* a patch before its headers */
+            patch++;
+        } else if (type == 0 || type > 19) {
+            return 0;
+        }
+        buf += 4;
+    }
+
+    /* the start codes and NAL headers are those of other codecs too */
+    if (sps && ph && patch && av_match_ext(p->filename, "svac,svac3"))
+        return AVPROBE_SCORE_EXTENSION + 1;
+    return 0;
+}
+
+FF_DEF_RAWVIDEO_DEMUXER(svac3, "raw SVAC 3.0", svac3_probe, "svac,svac3", AV_CODEC_ID_SVAC3)
